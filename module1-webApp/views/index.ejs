<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="NutriMate application for Recipe Finder and Nutrition Tracker">
    <meta name="author" content="Wisdom Samuel Etim">
    <meta property="og:title" content="NutriMate">
    <meta property="og:description" content="Use the Recipe Finder & Nutrition Tracker to discover healthy meals.">
    <meta property="og:image" content="/assets/hero-image.png">
    <meta property="og:type" content="website">

    <title>NutriMate | Home</title>

    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>

<!-- Header Section -->
<header>
    <nav>
        <div class="logo">
            <img src="/assets/logo remove bg.png" alt="NutriMate Logo">
            <h1>NutriMate</h1>
        </div>

        <div class="hamburger" aria-label="Toggle menu">☰</div>

        <ul class="nav-links">
            <li><a href="/">Home</a></li>
            <li><a href="/recipe">Recipe Finder</a></li>
            <li><a href="/nutrition">Nutrition</a></li>
        </ul>
    </nav>
</header>

<!-- Main Content Section -->
<main>

    <!-- Hero Section -->
    <section class="hero">
        <img src="/assets/hero-image.png" alt="Healthy food">

        <h1>Welcome to NutriMate</h1>

        <p>
            Your ultimate companion for healthy eating and nutrition tracking.
        </p>
       <!--hero section btn-->
        <a href="/recipe" class="btn">Find Recipes</a>
        <a href="/nutrition" class="btn">Track Nutrition</a>
    </section>
    <!---discover section-->
    <section class="Discover">
        <h2>Discover NutriMate</h2>

        <p>
            NutriMate is designed to help you make informed food choices and
            maintain a balanced diet. Whether you're looking for delicious
            recipes or want to track your daily nutrition, NutriMate has got
            you covered.
        </p>
    </section>
   <!---features section-->
    <section class="features">

        <h2>Our Features</h2>

        <div class="feature-grid">

            <div class="feature-card">

                <h3>Recipe Finder</h3>

                <p>
                    Find delicious recipes by entering ingredients you already
                    have at home. Explore different meal ideas, discover new
                    dishes, and follow simple cooking instructions to prepare
                    healthy and enjoyable meals.
                </p>

            </div>

            <div class="feature-card">

                <h3>Nutrition Tracker</h3>

                <p>
                    Check the nutritional value of your favorite foods and
                    meals. View information such as calories, protein,
                    carbohydrates, and fat to help you make healthier food
                    choices every day.
                </p>

            </div>

            <div class="feature-card">

                <h3>Personalized Recommendations</h3>

                <p>
                    Get meal suggestions based on your preferences and
                    nutritional needs. NutriMate helps you discover balanced
                    recipes that support a healthier lifestyle while making
                    meal planning easier.
                </p>

            </div>

        </div>

    </section>

</main> 
<!----footer section-->

<footer>

    <p>&copy; 2024 NutriMate. All rights reserved.</p>

    <p class="time"></p>

</footer>

<script type="module" src="/js/main.js"></script>

</body>
</html>